BACKEND_URL=http://127.0.0.1:8000
# Local default above requires the Python server (npm run lab).
# On v0/Vercel, replace it with the real deployed Python API HTTPS origin.
# Configure Development (v0 preview), Preview and Production separately.
# Do not append /api/v1. Deployment steps: docs/DEPLOYMENT.md.
# Default Ask BhuSanket prototype needs no AI credentials.
# Optional AI API endpoint only: put real credentials in ignored .env.local.
# OPENAI_API_KEY=
# OPENAI_MODEL=your-enabled-Responses-API-model-id
# No provider is configured by default; no simulated AI answers are used.
# Typed prototype Q&A and the labelled Evidence guide work without an AI key.
# After configuring the local credentials, restart npm run lab and reopen Ask BhuSanket.
# Keep credentials server-side. POWER does not require an API key.
# EARTHDATA_TOKEN=only-if-a-validated-adapter-requires-it
